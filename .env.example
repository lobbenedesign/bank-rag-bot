OPENAI_API_KEY=sk-...
# Leave unset to use OpenAI's cloud API. Point at a self-hosted
# OpenAI-compatible endpoint (e.g. LocalAI: http://localhost:8080/v1) to keep
# chat + embedding traffic entirely inside the bank's network. LocalAI
# doesn't validate OPENAI_API_KEY by default, so any placeholder value works.
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=bank_documents

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=bank_documents

REDIS_URL=redis://localhost:6379/0

POSTGRES_DSN=postgresql+asyncpg://bank_rag:bank_rag@localhost:5432/bank_rag

CORE_BANKING_BASE_URL=https://core-banking.internal
CORE_BANKING_SERVICE_TOKEN=change-me

ALLOWED_SCRAPE_DOMAIN=www.example-bank.it
ROUTER_MAX_ITERATIONS=4
RETRIEVAL_TOP_K=5

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_AUDIENCE=

RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_ADMIN_PER_MINUTE=10

CONVERSATION_TTL_SECONDS=86400
